# ===================================
# OPENAI API CONFIGURATION
# ===================================
# Điền API Key của bạn lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-actual-openai-api-key-here

# ===================================
# QDRANT VECTOR DATABASE CONFIGURATION
# ===================================
# Địa chỉ Qdrant đang chạy qua Docker (localhost:6333)
QDRANT_URL=http://localhost:6333

# Tên tập hợp (Collection) sẽ chứa các vector tài liệu trong Qdrant
COLLECTION_NAME=documents_collection

# ===================================
# RAG PIPELINE CONFIGURATION
# ===================================
# Tham số cắt nhỏ văn bản (Chunking)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Model Embedding chính dùng để biến văn bản thành Vector (1536 dims)
EMBEDDING_MODEL=text-embedding-3-small